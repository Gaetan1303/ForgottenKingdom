theme_override_font_sizes/font_size = 26
theme_override_colors/font_color = Color(0.85, 0.7, 1, 1)

[node name="Subtitle" type="Label" parent="Root"]
layout_mode = 2
text = "Choisissez le sceau d’une campagne existante ou gravez-en un nouveau."
