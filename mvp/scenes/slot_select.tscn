[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/slot_select.gd" id="1_slotselect"]

[node name="SlotSelect" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_slotselect")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.05, 0, 0.12, 1)

[node name="Root" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 24.0
offset_top = 20.0
offset_right = -24.0
offset_bottom = -20.0
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Root"]
layout_mode = 2
text = "REGISTRE DES HÉRITIERS"
