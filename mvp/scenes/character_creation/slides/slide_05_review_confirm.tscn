[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/character_creation/slides/slide_05_review_confirm.gd" id="1_slide"]

[node name="Slide05ReviewConfirm" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1_slide")

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 12.0
offset_top = 12.0
offset_right = -12.0
offset_bottom = -12.0
theme_override_constants/separation = 8

[node name="StepTitle" type="Label" parent="Content"]
layout_mode = 2
text = "Slide 5 - Fiche complete"
theme_override_font_sizes/font_size = 18

[node name="SummaryLabel" type="RichTextLabel" parent="Content"]
layout_mode = 2
size_flags_vertical = 3
bbcode_enabled = false
fit_content = true

[node name="ConfirmCheckBox" type="CheckBox" parent="Content"]
layout_mode = 2
text = "Je confirme la creation du personnage"

[node name="Nav" type="HBoxContainer" parent="Content"]
layout_mode = 2
alignment = 2

[node name="BtnPrev" type="Button" parent="Content/Nav"]
layout_mode = 2
text = "Precedent"

[node name="BtnFinish" type="Button" parent="Content/Nav"]
layout_mode = 2
text = "Commencer l'aventure"

[connection signal="pressed" from="Content/Nav/BtnPrev" to="." method="request_previous"]
[connection signal="pressed" from="Content/Nav/BtnFinish" to="." method="request_next"]
